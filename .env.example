# Neon Postgres connection string (see Phase 2)
DATABASE_URL=

# Auth.js (see Phase 3)
AUTH_SECRET=
AUTH_URL=

# Daily attention-item email digest (optional — attention items still show
# in-app without these; the digest just goes unsent).
RESEND_API_KEY=
EMAIL_FROM=
# Required in production to authorise the cron trigger — see vercel.json.
CRON_SECRET=

# Ask — the AI financial assistant (see /assistant). Optional — unset
# means the page shows a "not configured" state instead of a chat box.
ANTHROPIC_API_KEY=
# Overrides the default model (claude-sonnet-5). Optional.
ANTHROPIC_MODEL=

# Push notifications for attention items (see /security). Optional — unset
# hides the toggle entirely; the daily email digest is unaffected either
# way. Generate a keypair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact URI the push service can reach you at if it needs to
# (mailto: or https:). Required by the Web Push protocol itself.
VAPID_SUBJECT=
