# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local agent/CLI tooling metadata (e.g. `vercel install`'s skill docs) —
# not part of the app, shouldn't be versioned
.agents
.claude
skills-lock.json

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
/lib/generated/prisma
